# Supabase — lasciare vuoto per usare i dati demo locali (localStorage).
# Valorizzare entrambe per collegare l'app al progetto Supabase reale.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Studio corrente (v1, nessuno studio-switcher in UI). ID della riga in
# `studios` da usare per tutte le query — necessario solo quando
# VITE_SUPABASE_URL e' valorizzato.
VITE_DEFAULT_STUDIO_ID=

# --- Solo per le funzioni serverless in api/admin/* (Vercel Functions) ---
# MAI prefissarle con VITE_: finirebbero nel bundle inviato al browser.
# SUPABASE_SERVICE_ROLE_KEY in particolare bypassa la RLS: va impostata
# SOLO in Vercel Project Settings (Production/Preview/Development env),
# mai in un file committato nel repo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Vercel (automatico)
VERCEL_ENV=
